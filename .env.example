# Empty DB `intelligence` for v2 new tables.
# Credentials match .env.local (postgres / postgres @ 127.0.0.1:5432).

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/intelligence
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/intelligence

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://192.168.0.15:3002,http://localhost:9002,http://127.0.0.1:9002
APP_SECRET_KEY=change-me-v2
APP_ENV=development

OPENAI_API_KEY=

# NameBright Domain API (My domains) — from API management after approval
NAMEBRIGHT_CLIENT_ID=
NAMEBRIGHT_CLIENT_SECRET=
